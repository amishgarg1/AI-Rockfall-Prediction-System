# Where the Flask service lives. Vite inlines this at BUILD time, so it must be
# set in the build environment (Vercel project settings), not only at runtime.
# Leave unset locally and it falls back to http://127.0.0.1:5000.
VITE_API_URL=https://your-service.onrender.com

# Firebase is configured in src/firebase.js but the auth flow now runs through
# the Flask service and Postgres. These are only needed if you wire Firebase
# back up; the app runs without them.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
